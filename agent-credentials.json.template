{
  "<provider-slug>": {
    "<agent-id>": {
      "type": "api_key",
      "key": "doppler secrets get <PROVIDER>_API_KEY_<AGENT_NAME> -p <project> -c <config> --plain"
    },
    "<other-agent-id>": {
      "type": "api_key",
      "key": "doppler secrets get <PROVIDER>_API_KEY_<OTHER_AGENT_NAME> -p <other-project> -c <config> --plain"
    }
  }
}
