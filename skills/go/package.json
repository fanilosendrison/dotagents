{
  "name": "go-stage-harness",
  "version": "0.1.0",
  "description": "Standalone Turnlock-free stage harness for the /go workflow.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:bun": "bun test --timeout 60000 tests/stage-harness/acceptance tests/stage-harness/properties",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "fast-check": "3.23.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": "11.24.0"
  }
}
