{
	"name": "dotagents",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": "11.24.0"
	},
	"scripts": {
		"build:git-commits-push": "pnpm --filter git-commits-push-tl run build:node",
		"build:node-runtime": "pnpm --filter @dotagents/node-runtime run build",
		"build:skill-validator": "pnpm --filter @dotagents/skill-validator run build",
		"test": "bun run test:root && bun run test:git-commits-push && bun run test:scripts && bun run test:protocol",
		"test:root": "bun test --timeout 60000 --path-ignore-patterns='scripts/**' --path-ignore-patterns='skills/git-commits-push/**' --path-ignore-patterns='skills/loop-clean/protocol/**'",
		"test:git-commits-push": "bun run --cwd skills/git-commits-push test",
		"test:scripts": "bun run --cwd scripts test:bun",
		"test:scripts-node": "pnpm --filter @dotagents/scripts run test",
		"test:protocol": "bun run --cwd skills/loop-clean/protocol typecheck && bun run --cwd skills/loop-clean/protocol test:all",
		"test:create-symlink": "pnpm --filter create-symlink-for-dot-folders run test",
		"test:documentation-bootstraps": "node --test --test-concurrency=1 --test-timeout=30000 --test-reporter=tap skills/document-agent-enforcement/scripts/__tests__/bootstrap-enforcer-docs.test.mjs skills/document-agent-enforcement/scripts/__tests__/lib.test.mjs skills/document-self-modif/scripts/__tests__/bootstrap-docs.test.mjs skills/document-self-modif/scripts/__tests__/lib.test.mjs",
		"test:git-commits-push-launch-recognition": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --test-timeout=30000 --test-reporter=tap agent-enforcers/git-commits-push-enforcer/src/core/__tests__/launch-recognition.node.mjs",
		"test:git-commits-push-node-build": "pnpm --filter git-commits-push-tl run test:node:build",
		"test:node-runtime": "pnpm --filter @dotagents/node-runtime run test",
		"test:skill-validator": "pnpm --filter @dotagents/skill-validator run test",
		"typecheck:git-commits-push": "pnpm --filter git-commits-push-tl run typecheck:node",
		"typecheck:node-runtime": "pnpm --filter @dotagents/node-runtime run typecheck",
		"typecheck:scripts": "pnpm --filter @dotagents/scripts run typecheck",
		"typecheck:skill-validator": "pnpm --filter @dotagents/skill-validator run typecheck",
		"validate:skill": "pnpm run build:skill-validator && node skills/skill-creator/dist/quick-validate.mjs",
		"validate:test-parity": "node scripts/validate-test-parity.mjs"
	},
	"dependencies": {
		"js-yaml": "4.3.1"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/js-yaml": "^4.0.9"
	}
}
